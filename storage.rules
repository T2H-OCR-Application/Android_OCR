rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Per-user isolation for scan files
    match /users/{userId}/scans/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || (
                     // Limit max file size to 20MB
                     request.resource.size < 20 * 1024 * 1024 &&
                     // Restrict file types to PDF and JPEG
                     (request.resource.contentType == 'application/pdf' || request.resource.contentType == 'image/jpeg')
                   ));
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
